[user]
	# Set in ~/.extra to avoid committing personal info
	# name = Your Name
	# email = your.email@example.com

[core]
	excludesfile = ~/.gitignore_global
	editor = nvim
	autocrlf = input

[init]
	defaultBranch = main

[pull]
	rebase = false

[push]
	default = simple
	autoSetupRemote = true

[color]
	ui = auto

[color "branch"]
	current = yellow reverse
	local = yellow
	remote = green

[color "diff"]
	meta = yellow bold
	frag = magenta bold
	old = red bold
	new = green bold

[color "status"]
	added = yellow
	changed = green
	untracked = cyan

[alias]
	st = status
	co = checkout
	br = branch
	ci = commit
	unstage = reset HEAD --
	last = log -1 HEAD
	visual = log --graph --oneline --all
	amend = commit --amend --no-edit

[diff]
	tool = vimdiff

[merge]
	tool = vimdiff
	conflictstyle = diff3

[credential]
	helper = cache --timeout=3600
