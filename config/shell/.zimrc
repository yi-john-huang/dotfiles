# Zim modules loaded by ~/.zshrc via ~/.zim/init.zsh
# After changing modules, run: zimfw install && zimfw init

zmodule environment
zmodule input
zmodule termtitle
zmodule utility
zmodule git
zmodule completion
zmodule zsh-users/zsh-autosuggestions
zmodule zdharma-continuum/fast-syntax-highlighting
zmodule romkatv/powerlevel10k --use degit
